#!/bin/bash
# Git pre-push hook for ISLAND project
# Runs local tests before pushing to remote

set -euo pipefail

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo -e "${GREEN}🚀 Pre-push hook: Running local tests...${NC}"

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_ROOT"

# Check if we're pushing to main (extra caution)
read -r local_ref local_sha remote_ref remote_sha
if [[ "$remote_ref" == "refs/heads/main" ]] && [[ "$remote_sha" != "0000000000000000000000000000000000000000" ]]; then
    echo -e "${YELLOW}⚠️  Pushing to main!${NC}"
    echo -e "${YELLOW}Running comprehensive tests...${NC}"
    
    # Run all tests
    if ! ./scripts/ci-cd.sh test; then
        echo -e "${RED}❌ Tests failed! Push blocked.${NC}"
        exit 1
    fi
    
    echo -e "${GREEN}✓ All tests passed!${NC}"
fi

echo -e "${GREEN}✓ Pre-push hook passed!${NC}"
exit 0
